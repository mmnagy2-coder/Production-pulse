# Copy to .env and fill in. .env is gitignored.
#
# Supabase → Project Settings → Database gives you two connection strings and
# they are NOT interchangeable:
#
#   - Direct connection (db.<ref>.supabase.co:5432)
#     Use this locally and for `drizzle-kit generate/migrate` — DDL needs a
#     real session.
#
#   - Transaction pooler (aws-0-<region>.pooler.supabase.com:6543)
#     Use this for the deployed Netlify Function. Serverless invocations must
#     not hold direct Postgres connections.
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Supabase → Project Settings → API
# The API server fetches the JWKS from ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# to verify access tokens.
SUPABASE_URL=https://<ref>.supabase.co

# Same URL and the publishable anon key, baked into the client bundle at build
# time. VITE_ prefixed vars are PUBLIC — never put the service role key here.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Optional. Without it the AI routes (script breakdown, schedule warnings, AD
# call-sheet review) return unavailable rather than failing.
ANTHROPIC_API_KEY=

# Local dev only. The API server port, and the target Vite proxies /api to.
# In production Netlify's redirect does this instead.
PORT=8080
LOCAL_API_PROXY_TARGET=http://localhost:8080

# Optional: pino log level (default info)
# LOG_LEVEL=debug
